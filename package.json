{
  "name": "brianbrady.dev",
  "version": "0.1.0",
  "private": true,
  "description": "Portfolio website for brianbrady.dev.",
  "scripts": {
    "start": "npx serve .",
    "test": "node scripts/check-ui.mjs",
    "check": "node --check script.js && node --check art.js && node --check scripts/export-pdf.mjs && node --check scripts/capture-previews.mjs && node --check scripts/crop-project-images.mjs && node --check scripts/check-ui.mjs",
    "capture:previews": "node scripts/capture-previews.mjs",
    "crop:projects": "node scripts/crop-project-images.mjs",
    "export:pdf": "node scripts/export-pdf.mjs",
    "export:pdf:index": "node scripts/export-pdf.mjs index.html dist/index.pdf",
    "export:pdf:contact": "node scripts/export-pdf.mjs contact.html dist/contact.pdf"
  },
  "keywords": [
    "portfolio",
    "static-site",
    "design-systems",
    "web-components"
  ],
